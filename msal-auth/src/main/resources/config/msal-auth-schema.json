{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "enabled",
    "loginPath",
    "logoutPath",
    "cookieDomain",
    "cookiePath",
    "cookieSecure",
    "sessionTimeout",
    "cookieSameSite"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "loginPath": {
      "type": "string",
      "default": "/auth/ms/login"
    },
    "logoutPath": {
      "type": "string",
      "default": "/auth/ms/logout"
    },
    "logoutCsrfEnforced": {
      "type": "boolean",
      "default": false
    },
    "cookieDomain": {
      "type": "string",
      "default": "localhost"
    },
    "cookiePath": {
      "type": "string",
      "default": "/"
    },
    "cookieSecure": {
      "type": "boolean",
      "default": false
    },
    "sessionTimeout": {
      "type": "integer",
      "format": "int32",
      "minimum": 1,
      "default": 3600
    },
    "cookieSameSite": {
      "type": "string",
      "enum": [
        "Strict",
        "Lax",
        "None"
      ],
      "default": "None"
    },
    "tenantId": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "requiredScopes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "allowedClientIds": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "tenantId",
          "issuer",
          "audience",
          "requiredScopes",
          "allowedClientIds"
        ],
        "properties": {
          "tenantId": {
            "minLength": 1
          },
          "issuer": {
            "minLength": 1
          },
          "audience": {
            "minLength": 1
          },
          "requiredScopes": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "allowedClientIds": {
            "oneOf": [
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    }
  ]
}
